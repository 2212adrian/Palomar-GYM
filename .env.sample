
# ==========================================
# PALOMAR GYM MANAGEMENT SYSTEM 2.0 - PRODUCTION
# ==========================================

# --- Supabase Configuration (Production Project) ---
#VITE_SUPABASE_URL=https://your-prod-project-id.supabase.co
#VITE_SUPABASE_ANON_KEY=your-prod-supabase-anon-public-key

# --- Application URL (For Production Redirects) ---
#VITE_APP_URL=https:<Your URL HERE>

# --- External APIs ---
#VITE_OPEN_FOOD_FACTS_APP_NAME=PalomarGymManagementSystem/2.0 (contact@yourgymdomain.com)


# ==========================================
# PALOMAR GYM MANAGEMENT SYSTEM 2.0 - DEVELOPMENT
# ==========================================

# --- Supabase Configuration (Development Project) ---
VITE_SUPABASE_URL=https://your-prod-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-prod-supabase-anon-public-key

# --- Application URL (For Local Redirects) ---
VITE_APP_URL=http://localhost:9999

# --- External APIs ---
VITE_OPEN_FOOD_FACTS_APP_NAME=PalomarGymManagementSystem-Dev/2.0 (contact@yourgymdomain.com)

# ==========================================




# Supabase Service Role Key (Required for Netlify Functions to bypass RLS 
# and programmatically create/manage staff accounts, as public registration is disabled)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Server-Side / Netlify Functions Secrets (DO NOT expose to client) ---

# Nodemailer Configuration (For Automated Notifications / Incident Reports)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=notifications@yourgymdomain.com
SMTP_PASS=your-secure-smtp-password
SENDER_EMAIL=notifications@yourgymdomain.com
ADMIN_NOTIFICATION_EMAIL=admin@yourgymdomain.com